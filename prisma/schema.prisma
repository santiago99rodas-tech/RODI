// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Trip {
  id            String    @id @default(cuid())
  shop          String
  customerId    String
  title         String
  destination   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("planning")
  coverImageUrl String?
  budgetTotal    Float?
  budgetCurrency String   @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  days         Day[]
  checklist    ChecklistItem[]
  expenses     Expense[]
  documents    Document[]
  participants Participant[]

  @@index([shop, customerId])
}

model Participant {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@index([tripId])
}

model Day {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date      DateTime
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([tripId])
}

model Activity {
  id        String   @id @default(cuid())
  dayId     String
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  time      String?
  title     String
  category  String?
  location  String?
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label     String
  category  String?
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  // "manual" (typed by the customer) | "default_template" (today's fixed
  // starter checklist) | "smart" (Fase 3 Smart Packing generator, Club-only)
  // — lets a Smart Packing regenerate wipe only its own items on a re-run
  // without touching anything the customer added themselves.
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

model Expense {
  id          String       @id @default(cuid())
  tripId      String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    String       @default("otros")
  label       String
  amount      Float
  date        DateTime?
  paidById    String?
  paidBy      Participant? @relation(fields: [paidById], references: [id], onDelete: SetNull)
  // "budget" (Presupuesto page) | "split" (Split de gastos) — Budget and
  // Split shared one Expense pool with no way to tell them apart before
  // this field; Fase 3 gates them independently (Split is Club-only), so
  // Budget's "all expenses" views must now filter to kind:"budget" or
  // they'd double-count Split entries once those exist.
  kind        String       @default("budget")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tripId])
  @@index([paidById])
}

// Documents can belong to one trip (tripId set, e.g. a hotel reservation)
// or to the member directly (tripId null, e.g. a passport that outlives any
// single trip) — the Alertas de vencimiento page reads the customer-level
// ones via shop+customerId, independent of trips.
model Document {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title      String
  category   String   @default("otro")
  url        String?
  note       String?
  expiresAt  DateTime?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId])
  @@index([shop, customerId])
}

model EmergencyContact {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  name       String
  phone      String?
  note       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, customerId])
}

// Internal bookkeeping for RODI Club membership state — never read directly
// for gating. resolveMembership() in app/membership.server.ts is the single
// place that turns this into an effective status, and the only thing ever
// projected out to the theme is one derived date (club_access_until, via a
// customer metafield): status here can go stale between events (no cron
// exists in this app to sweep expirations), the projected date can't.
model Membership {
  id               String    @id @default(cuid())
  shop             String
  customerId       String
  status           String    @default("FREE") // FREE | PROMOTIONAL_ACCESS | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  promoStart       DateTime?
  promoEnd         DateTime?
  promoSource      String?   // e.g. "launch_2026", "manual_grant"
  subscriptionId   String?   // reserved for Fase 2 (Shopify subscription/contract id)
  currentPeriodEnd DateTime? // reserved for Fase 2
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, customerId])
}
