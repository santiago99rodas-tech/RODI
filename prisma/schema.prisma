// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Trip {
  id            String    @id @default(cuid())
  shop          String
  customerId    String
  title         String
  destination   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("planning")
  coverImageUrl String?
  // Smart packing preferences (JSON, see app/pack.server.ts). Null until a Club member sets them.
  packPrefs     String?
  // Answers of the "Plan a trip" assistant: who travels, what they like (JSON, see app/trip-wizard.server.ts).
  wizard        String?
  budgetTotal    Float?
  budgetCurrency String   @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  days             Day[]
  checklist        ChecklistItem[]
  expenses         Expense[]
  documents        Document[]
  participants     Participant[]
  journalEntries   JournalEntry[]
  serviceInquiries ServiceInquiry[]
  places           TripPlace[]

  @@index([shop, customerId])
}

model Participant {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  // Share of the group's cost this person carries, relative to the others
  // (1 = a full adult share, 0.6 = a child paying 60%). Set when the
  // calculator pushes its travelers into Split; manual participants keep 1.
  weight    Float    @default(1)
  // Optional contact so Split can open a pre-filled e-mail / WhatsApp message for this person.
  email     String?
  phone     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@index([tripId])
}

model Day {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date      DateTime
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([tripId])
}

model Activity {
  id        String   @id @default(cuid())
  dayId     String
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  time      String?
  title     String
  category  String?
  location  String?
  imageUrl  String?
  // Route map (Club): where the stop is and a short note. Null for stops typed in by hand.
  lat       Float?
  lng       Float?
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label     String
  category  String?
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  // "manual" (typed by the customer) | "default_template" (today's fixed
  // starter checklist) | "smart" (Fase 3 Smart Packing generator, Club-only)
  // — lets a Smart Packing regenerate wipe only its own items on a re-run
  // without touching anything the customer added themselves.
  source    String   @default("manual")
  // Smart packing items are derived in the theme; a row exists only once the member ticks one or changes its quantity.
  // `key` is the language-neutral id of that item ("tee", "act:beach:0"), `qty` the quantity they chose (null = suggested).
  key       String?
  qty       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([tripId, key])
}

model Expense {
  id          String       @id @default(cuid())
  tripId      String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    String       @default("otros")
  label       String
  amount      Float
  date        DateTime?
  paidById    String?
  paidBy      Participant? @relation(fields: [paidById], references: [id], onDelete: SetNull)
  // "budget" (Presupuesto page) | "split" (Split de gastos) — Budget and
  // Split shared one Expense pool with no way to tell them apart before
  // this field; Fase 3 gates them independently (Split is Club-only), so
  // Budget's "all expenses" views must now filter to kind:"budget" or
  // they'd double-count Split entries once those exist.
  kind        String       @default("budget")
  // Set when the row was generated from a CalculatorPlan, so applying that
  // plan again replaces its own rows instead of duplicating them (no
  // relation: deleting a plan must not delete expenses the member kept).
  planId      String?
  // JSON array of participant ids this expense is split between; null = everyone. A payment between two
  // people is recorded as an expense paid by the payer and split with only the receiver.
  splitWith   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tripId])
  @@index([paidById])
  @@index([planId])
}

// Documents can belong to one trip (tripId set, e.g. a hotel reservation)
// or to the member directly (tripId null, e.g. a passport that outlives any
// single trip) — the Alertas de vencimiento page reads the customer-level
// ones via shop+customerId, independent of trips.
model Document {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title      String
  category   String   @default("otro")
  url        String?
  note       String?
  expiresAt  DateTime?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId])
  @@index([shop, customerId])
}

model EmergencyContact {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  name       String
  phone      String?
  note       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, customerId])
}

// Internal bookkeeping for RODI Club membership state — never read directly
// for gating. resolveMembership() in app/membership.server.ts is the single
// place that turns this into an effective status, and the only thing ever
// projected out to the theme is one derived date (club_access_until, via a
// customer metafield): status here can go stale between events (no cron
// exists in this app to sweep expirations), the projected date can't.
model Membership {
  id               String    @id @default(cuid())
  shop             String
  customerId       String
  status           String    @default("FREE") // FREE | PROMOTIONAL_ACCESS | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  promoStart       DateTime?
  promoEnd         DateTime?
  promoSource      String?   // e.g. "launch_2026", "manual_grant"
  subscriptionId   String?   // reserved for Fase 2 (Shopify subscription/contract id)
  currentPeriodEnd DateTime? // reserved for Fase 2
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, customerId])
}

// Fase 3 Milestone 5, Club-only. A personal travel journal entry — may
// belong to a trip (tripId) or stand alone (e.g. a memory from before the
// Trip Planner existed). countryHandle is a plain string (the country
// metaobject's handle, e.g. "morocco"), not a Prisma relation — Shopify
// metaobjects live outside this database, so it's just a tag for display,
// not a foreign key. Year in Travel reads this table directly (see
// buildYearInTravel in apps.proxy.tsx) rather than the unstructured
// customer.travel_log metafield, which has free-text dates.
model JournalEntry {
  id            String    @id @default(cuid())
  shop          String
  customerId    String
  tripId        String?
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  countryHandle String?
  title         String?
  body          String
  photoUrl      String?
  entryDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, customerId])
  @@index([tripId])
}

// Journal book (Club): one free-form page per visited country (items positioned in percent of the page, as JSON) and the
// photos pasted on them. Photos are stored already shrunk by the browser; see journal-book.server.ts.
model JournalPage {
  id            String   @id @default(cuid())
  shop          String
  customerId    String
  countryHandle String
  data          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, customerId, countryHandle])
  @@index([shop, customerId])
}

model JournalPhoto {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  mime       String
  size       Int
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@index([shop, customerId])
}

// Fase 3 Milestone 6, Club-only to post, public to read (status:"published").
// authorName is a snapshot of the customer's display name at post time —
// the proxy only ever gets a numeric customerId from Shopify, not a profile
// lookup, so the theme sends the name along with the post instead of this
// app fetching it. status is the moderation lever (app.community-
// moderation.tsx): published is visible publicly, flagged/removed are not,
// and nothing here is ever hard-deleted by a member-facing op.
model CommunityQuestion {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  authorName String
  title      String
  body       String
  status     String   @default("published") // published | flagged | removed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  answers CommunityAnswer[]

  @@index([shop, status])
}

model CommunityAnswer {
  id         String            @id @default(cuid())
  shop       String
  customerId String
  authorName String
  questionId String
  question   CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String
  status     String            @default("published")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([questionId])
  @@index([shop, status])
}

model CommunityRecommendation {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  authorName String
  title      String
  body       String
  category   String?
  city       String?
  status     String   @default("published")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, status])
}

// Community forum (Club): one stream of questions and recommendations, each with up to 10 replies.
// Supersedes CommunityQuestion / CommunityAnswer / CommunityRecommendation (their rows were copied in by the
// 20261020120000_add_community_forum migration; the old tables stay for the old theme pages until they are retired).
model CommunityPost {
  id              String   @id @default(cuid())
  shop            String
  customerId      String
  authorName      String
  type            String   // question | recommendation
  title           String
  body            String
  country         String?  // country metaobject handle
  city            String?
  topic           String   @default("general")
  tags            String?  // JSON array of lowercase hashtags (no #)
  rating          Int?     // 1-5, recommendations only
  status          String   @default("published") // published | flagged | removed
  likeCount       Int      @default(0)
  replyCount      Int      @default(0)
  reportCount     Int      @default(0)
  acceptedReplyId String?  // the reply the asker marked as helpful
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  replies CommunityReply[]

  @@index([shop, status, createdAt])
  @@index([shop, status, country])
  @@index([shop, status, topic])
  @@index([customerId])
}

model CommunityReply {
  id          String        @id @default(cuid())
  shop        String
  customerId  String
  authorName  String
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  body        String
  status      String        @default("published")
  likeCount   Int           @default(0)
  reportCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId])
  @@index([customerId])
}

model CommunityLike {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  targetType String   // post | reply
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([customerId, targetType, targetId])
  @@index([targetType, targetId])
}

// Fase 4, RODI Services. Open to any signed-in customer (no Club gate —
// these are paid add-ons, not a membership perk), but there's no live
// payment gateway yet (Fase 2 is paused), so this is a waitlist/inquiry
// pipeline rather than a real purchase: a customer requests a service,
// RODI follows up manually. status tracks that manual pipeline;
// "purchased" is reserved for when Fase 2 billing exists. internalNote is
// admin-only — app.service-inquiries.tsx can read/write it, but the
// customer-facing services=1 read in apps.proxy.tsx always omits it.
model ServiceInquiry {
  id           String   @id @default(cuid())
  shop         String
  customerId   String
  serviceType  String   // the `service` metaobject's slug
  tripId       String?
  trip         Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  status       String   @default("information_required") // information_required | in_review | delivered | closed | purchased
  notes        String?
  internalNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, customerId])
  @@index([tripId])
}

// Transactional emails sent by the app through Resend (see app/emails.server.ts).
// One row per customer + template: it is both the audit trail and the guard
// that stops a webhook retry from emailing the same person twice.
model EmailLog {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  template   String   // account-ready | welcome-club
  locale     String?
  recipient  String?
  status     String   @default("sending") // sending | sent | failed
  providerId String?  // Resend message id
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, customerId, template])
}

// Marketing campaigns sent from the app through Resend (Admin > Campaigns). A campaign snapshots its audience
// (CampaignRecipient rows) when it is prepared, so progress survives restarts and a recipient can never be mailed twice.
model Campaign {
  id         String              @id @default(cuid())
  shop       String
  template   String              // one of the marketing templates in emails/
  params     String              // JSON: copy fields, discount code, chapter, product snapshot
  audience   String              // subscribed | club
  status     String              @default("draft") // draft | sending | sent | cancelled
  total      Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  recipients CampaignRecipient[]

  @@index([shop, createdAt])
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  customerId String
  email      String
  locale     String
  status     String   @default("pending") // pending | sent | failed | skipped
  providerId String?
  error      String?
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([customerId])
}

// Abandoned-cart reminders sent by the app (see app/abandoned-carts.server.ts). One row per checkout: it records the
// result and guarantees a cart is emailed at most once.
model AbandonedCartLog {
  id         String   @id @default(cuid())
  shop       String
  checkoutId String
  customerId String?
  email      String
  status     String   @default("sending") // sending | sent | failed
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, checkoutId])
  @@index([shop, email, createdAt])
}

// A member saving a destination (country page / Destinations cards). The customer's own list lives in the
// custom.saved_countries metafield (Liquid reads it); this table exists so the app can count saves per country
// for the "Member favorites" ranking, which Liquid cannot do across customers.
model CountrySave {
  id            String   @id @default(cuid())
  shop          String
  customerId    String
  countryHandle String
  createdAt     DateTime @default(now())

  @@unique([shop, customerId, countryHandle])
  @@index([shop, countryHandle])
}

// A country in a member's passport (any status). Mirrors custom.travel_log for the popularity ranking only.
model CountryTravel {
  id            String   @id @default(cuid())
  shop          String
  customerId    String
  countryHandle String
  status        String
  updatedAt     DateTime @updatedAt

  @@unique([shop, customerId, countryHandle])
  @@index([shop, countryHandle])
}

// A saved Trip Cost Calculator plan. `data` is the sanitized plan JSON
// (see calc-plan.server.ts); `total` and `currency` are recomputed by the
// server on every save and only used for the plan list.
model CalculatorPlan {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  name       String
  currency   String   @default("USD")
  total      Float    @default(0)
  tripId     String?
  data       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, customerId])
}

// Route map (Club): places a member saved on the map that are not in a day yet ("por asignar"),
// optionally marked "want" (Quiero ir) or "review" (Revisar lugar). Assigning one to a day turns it into an Activity.
model TripPlace {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  lat       Float
  lng       Float
  note      String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

// Legal acceptance log (Terms, Privacy, marketing). Append-only: one row per document per acceptance attempt, so the
// record shows what each member agreed to, when, and from where. Only the birth YEAR and MONTH are kept (never the day);
// the age band is recomputed from them on every read (ageBand here is the snapshot at the time of the row). A refused
// attempt (under 15) is stored with accepted=false so the gate can keep showing the block.
model LegalAcceptance {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  document   String   // terms | privacy | marketing
  version    String
  accepted   Boolean
  ageBand    String?  // adult | minor | under_15
  birthYear  Int?
  birthMonth Int?     // 1-12
  ip         String?
  userAgent  String?
  source     String   // club-gate
  createdAt  DateTime @default(now())

  @@index([shop, customerId, document, version])
  @@index([shop, customerId, createdAt])
}

// Parent/guardian authorization for a member aged 15-17. The emailed link carries a random token; only its HMAC is
// stored (tokenHash), so the database alone cannot produce a working link.
model GuardianConsent {
  id                String    @id @default(cuid())
  shop              String
  customerId        String
  tokenHash         String    @unique
  status            String    @default("pending") // pending | approved | declined | superseded
  guardianEmail     String
  locale            String    @default("es")
  expiresAt         DateTime
  lastSentAt        DateTime?
  approvedAt        DateTime?
  approvedIp        String?
  approvedUserAgent String?
  declinedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shop, customerId, createdAt])
}

// Privacy requests (access/export and erasure) from members and from Shopify's mandatory compliance webhooks.
// Kept as the audit trail after the data itself is gone, so it holds ids and outcomes only.
model DataRequest {
  id               String   @id @default(cuid())
  shop             String
  customerId       String?
  type             String   // export | erase
  source           String   // member | shopify_webhook | guardian_timeout
  status           String   // done | shopify_pending | emailed | failed
  detail           String?
  shopifyRequestId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, createdAt])
}
